# Yerel: NODE_ENV=development yeterli. Oturum cerezi http:// ile her zaman calisir.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace_with_minimum_32_char_random_secret
ADMIN_PASSWORD=replace_with_strong_admin_password
# Canli site HTTPS ise guvenlik icin mutlaka acin (aksi halde cerez Secure degildir):
# SESSION_COOKIE_SECURE=true
